---
const { class: className = '' } = Astro.props;
---
<svg class={className} viewBox="0 0 64 64" aria-hidden="true">
  <defs>
    <linearGradient id="gold" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#f6e2b0"></stop>
      <stop offset="0.5" stop-color="#e0b45a"></stop>
      <stop offset="1" stop-color="#a67c32"></stop>
    </linearGradient>
  </defs>
  <circle cx="32" cy="32" r="28" fill="none" stroke="url(#gold)" stroke-width="2.5"></circle>
  <circle cx="32" cy="32" r="18" fill="none" stroke="url(#gold)" stroke-width="1.2" opacity="0.8"></circle>
  <path d="M32 12l2.6 14.2L49 28.6 34.6 31.4 32 46l-2.6-14.6L15 28.6l14.4-2.4z" fill="url(#gold)"></path>
</svg>
