---
const { href = '' } = Astro.props;
const locked = !href;
---
<span class:list={['badge-lock', locked && 'badge-disabled']}>
  {
    locked ? (
      <span aria-disabled="true">
        <svg viewBox="0 0 180 54" role="img" aria-label="Download on the App Store, coming soon">
          <rect width="180" height="54" rx="8" fill="#000" stroke="#a2a2a2"></rect>
          <path d="M24 14c2 1.6 3.3 3.8 3 6.2-2.8.2-5.4-1.6-6.6-3.6-1.4-1.8-2.4-4.2-2-6.2 2.8-.1 5 1.4 5.6 3.6z" fill="#fff"></path>
          <path d="M27.2 21.2c-3.4-.2-6.3 1.9-7.9 1.9-1.7 0-4.2-1.8-6.9-1.7-3.5.1-6.8 2.1-8.6 5.3-3.7 6.4-1 15.8 2.6 21 1.8 2.5 3.8 5.3 6.5 5.2 2.6-.1 3.6-1.6 6.7-1.6s4 .7 6.8 1.6c2.8.1 4.6-2.5 6.3-5 2-2.9 2.8-5.7 2.9-5.8-.1 0-5.5-2.1-5.6-8.4-.1-5.2 4.3-7.7 4.5-7.9-2.5-3.6-6.3-4-7.3-4.1z" fill="#fff"></path>
          <text x="48" y="22" fill="#fff" font-size="9" font-family="Outfit, sans-serif">Download on the</text>
          <text x="48" y="40" fill="#fff" font-size="16" font-family="Syne, sans-serif">App Store</text>
        </svg>
        <span class="soon">Coming soon</span>
      </span>
    ) : (
      <a href={href} rel="noopener noreferrer" target="_blank">
        <svg viewBox="0 0 180 54" role="img" aria-label="Download on the App Store">
          <rect width="180" height="54" rx="8" fill="#000" stroke="#a2a2a2"></rect>
          <text x="48" y="22" fill="#fff" font-size="9" font-family="Outfit, sans-serif">Download on the</text>
          <text x="48" y="40" fill="#fff" font-size="16" font-family="Syne, sans-serif">App Store</text>
        </svg>
      </a>
    )
  }
</span>
