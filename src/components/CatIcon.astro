---
const { name = 'tag' } = Astro.props;
---
<svg class="cat-icon" viewBox="0 0 24 24" aria-hidden="true">
  {name === 'laptop' && <path d="M4 6h16v9H4zM2 17h20" fill="none" stroke="currentColor" stroke-width="1.6" />}
  {name === 'desktop' && <path d="M4 5h16v10H4zM9 18h6M12 15v3" fill="none" stroke="currentColor" stroke-width="1.6" />}
  {name === 'monitor' && <path d="M3 5h18v11H3zM8 20h8" fill="none" stroke="currentColor" stroke-width="1.6" />}
  {name === 'phone' && <rect x="7" y="3" width="10" height="18" rx="2" fill="none" stroke="currentColor" stroke-width="1.6" />}
  {name === 'tablet' && <rect x="5" y="3" width="14" height="18" rx="2" fill="none" stroke="currentColor" stroke-width="1.6" />}
  {name === 'watch' && <circle cx="12" cy="12" r="5" fill="none" stroke="currentColor" stroke-width="1.6" />}
  {name === 'server' && <path d="M5 5h14v4H5zM5 15h14v4H5z" fill="none" stroke="currentColor" stroke-width="1.6" />}
  {name === 'cpu' && <rect x="7" y="7" width="10" height="10" fill="none" stroke="currentColor" stroke-width="1.6" />}
  {name === 'gpu' && <path d="M4 8h16v8H4zM8 16v3M16 16v3" fill="none" stroke="currentColor" stroke-width="1.6" />}
  {name === 'ram' && <path d="M5 8h14v8H5zM8 8v8M12 8v8M16 8v8" fill="none" stroke="currentColor" stroke-width="1.6" />}
  {name === 'disk' && <circle cx="12" cy="12" r="7" fill="none" stroke="currentColor" stroke-width="1.6" />}
  {name === 'board' && <rect x="4" y="4" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" />}
  {name === 'plug' && <path d="M8 8v5a4 4 0 0 0 8 0V8M9 4v4M15 4v4" fill="none" stroke="currentColor" stroke-width="1.6" />}
  {name === 'router' && <path d="M5 14h14v5H5zM8 14l2-6M16 14l-2-6" fill="none" stroke="currentColor" stroke-width="1.6" />}
  {name === 'switch' && <rect x="3" y="8" width="18" height="8" fill="none" stroke="currentColor" stroke-width="1.6" />}
  {name === 'shield' && <path d="M12 3 19 6v6c0 4-3 6-7 8-4-2-7-4-7-8V6z" fill="none" stroke="currentColor" stroke-width="1.6" />}
  {name === 'wifi' && <path d="M5 10a10 10 0 0 1 14 0M8 13a6 6 0 0 1 8 0M12 17h.1" fill="none" stroke="currentColor" stroke-width="1.6" />}
  {name === 'cable' && <path d="M7 7h4v10H7zM13 10h4v7h-4z" fill="none" stroke="currentColor" stroke-width="1.6" />}
  {name === 'case' && <rect x="6" y="3" width="12" height="18" rx="2" fill="none" stroke="currentColor" stroke-width="1.6" />}
  {name === 'keyboard' && <rect x="3" y="7" width="18" height="10" fill="none" stroke="currentColor" stroke-width="1.6" />}
  {name === 'headphones' && <path d="M5 13v4M19 13v4M5 13a7 7 0 0 1 14 0" fill="none" stroke="currentColor" stroke-width="1.6" />}
  {name === 'dock' && <path d="M4 15h16M8 15V9h8v6" fill="none" stroke="currentColor" stroke-width="1.6" />}
  {name === 'printer' && <path d="M7 8V4h10v4M6 12h12v7H6zM6 12H4v-2h16v2h-2" fill="none" stroke="currentColor" stroke-width="1.6" />}
  {name === 'home' && <path d="M4 11 12 4l8 7v8H4z" fill="none" stroke="currentColor" stroke-width="1.6" />}
  {name === 'game' && <rect x="3" y="8" width="18" height="8" rx="3" fill="none" stroke="currentColor" stroke-width="1.6" />}
  {name === 'shirt' && <path d="M8 6 12 4l4 2 4 2-2 3h-3v9H9V11H6L4 8z" fill="none" stroke="currentColor" stroke-width="1.6" />}
  {name === 'spark' && <path d="M12 3l1.5 6L20 12l-6.5 1.5L12 20l-1.5-6.5L4 12l6.5-1.5z" fill="none" stroke="currentColor" stroke-width="1.6" />}
  {name === 'image' && <rect x="4" y="5" width="16" height="14" fill="none" stroke="currentColor" stroke-width="1.6" />}
  {name === 'box' && <path d="M4 8l8-4 8 4v8l-8 4-8-4z" fill="none" stroke="currentColor" stroke-width="1.6" />}
  {name === 'refresh' && <path d="M6 12a6 6 0 1 0 2-4.5M6 4v4h4" fill="none" stroke="currentColor" stroke-width="1.6" />}
  {name === 'cart' && <path d="M4 6h2l2 10h10l2-7H8" fill="none" stroke="currentColor" stroke-width="1.6" />}
  {name === 'tag' && <path d="M4 12 12 4h7v7l-8 8z" fill="none" stroke="currentColor" stroke-width="1.6" />}
</svg>
