---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import Newsletter from '../components/Newsletter.astro';
import TrustStrip from '../components/TrustStrip.astro';
import RefreshSplash from '../components/RefreshSplash.astro';
import Orbit from '../components/Orbit.astro';
import CatIcon from '../components/CatIcon.astro';
import HomeListings from '../components/HomeListings.astro';
import {
  allProducts,
  homeMarketplaceListings,
  priceOf,
  settings,
  SITE,
  visibleCategories,
} from '../lib/site';

const products = await allProducts();
const deals = products.filter((product) => product.data.featured || priceOf(product) < product.data.price).slice(0, 8);
const flash = products.filter((product) => typeof product.data.flash_price === 'number' && product.data.flash_start && product.data.flash_end);
const market = homeMarketplaceListings();
const etsyCount = market.filter((item) => item.source === 'etsy').length;
const ebayCount = market.filter((item) => item.source === 'ebay').length;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Store',
  name: settings.business_name,
  url: SITE,
  email: settings.sales_email,
  address: { '@type': 'PostalAddress', addressLocality: 'Palo Alto', addressRegion: 'CA', addressCountry: 'US' },
  description: settings.tagline,
};
---
<BaseLayout title="Hand-tested tech in Palo Alto" description={settings.tagline} path="/" jsonLd={jsonLd}>
  <nav class="cat-strip-wrap" aria-label="Shop by category">
    <div class="wrap cat-strip-bar">
      <button class="cat-strip-arrow" type="button" data-cat-strip-prev aria-label="Previous categories">‹</button>
      <div class="cat-strip" data-cat-strip>
        {visibleCategories().map((category) => (
          <a class={`cat-tile tone-${category.tone}`} href={category.href}>
            <span class="cat-tile-art" aria-hidden="true"><CatIcon name={category.icon} /></span>
            <span class="cat-tile-label">{category.label}</span>
          </a>
        ))}
      </div>
      <button class="cat-strip-arrow" type="button" data-cat-strip-next aria-label="Next categories">›</button>
    </div>
  </nav>
  <RefreshSplash />
  <div class="shift-hero">
  <section class="wrap hero">
    <figure class="hero-mark">
      <img
        src="/images/logo-hero.png"
        srcset="/images/logo-hero.png 1x, /images/logo-hero@2x.png 2x"
        alt=""
        width="480"
        height="392"
      />
    </figure>
    <div>
      <p class="eyebrow">Earn It Not Given LLC · {settings.location_label}</p>
      <h1>Tested gear. Earned style.</h1>
      <p class="lede">{settings.tagline} Every electronic and computer is checked by hand before it is listed. Designs from the EarnItNotGiven print shop check out on Etsy.</p>
      <div class="actions">
        <a class="btn btn-gold" href="/shop">Shop the bench</a>
        <a class="btn btn-ghost" href="/designs">EarnItNotGiven designs</a>
      </div>
      <ul class="trust">
        <li>Hand-tested</li>
        <li>Palo Alto</li>
        <li>A real person on email</li>
      </ul>
    </div>
  </section>
  </div>

  <section class="wrap section" id="from-the-shop">
    <p class="eyebrow">Etsy · eBay</p>
    <h2>Featured from the shop</h2>
    <p class="muted">Active listings from the EarnItNotGiven Etsy shop and eBay seller workhard1140, mixed together. Checkout stays on Etsy or eBay.</p>
    {market.length ? (
      <div class="grid cards">
        <HomeListings items={market} />
      </div>
    ) : (
      <p class="empty">No verified Etsy or eBay listings are in the catalog yet.</p>
    )}
    <p class="market-links">
      <a href="/designs">All Etsy designs{etsyCount ? ` (${etsyCount})` : ''}</a>
      <a href="/ebay">All eBay electronics{ebayCount ? ` (${ebayCount})` : ''}</a>
    </p>
  </section>

  <TrustStrip />
  {flash.length > 0 && (
    <section class="wrap section" data-flash-strip>
      <p class="eyebrow">Pacific Time</p>
      <h2>Flash deals</h2>
      <div class="strip">
        {flash.map((product) => <ProductCard product={product} flash />)}
      </div>
      <p><a href="/deals">All flash deals</a></p>
    </section>
  )}

  <section class="wrap section tone-tech">
    <h2>On the bench</h2>
    <p class="muted">Hand-tested electronics and computers listed for sale on this site.</p>
    {deals.length ? (
      <div class="strip">
        {deals.map((product) => <ProductCard product={product} />)}
      </div>
    ) : <p class="empty">Nothing on the bench yet. The Etsy and eBay listings above are live now.</p>}
  </section>

  <section class="wrap section">
    <a class="orbit-tile" href="/guardianorbit">
      <Orbit />
      <div>
        <p class="eyebrow">Coming to iPhone and Apple Watch</p>
        <h2>GuardianOrbit</h2>
        <p>Arrival and departure alerts, timed check-ins, and SOS to trusted contacts. Built for families. Privacy-first. Not a health device.</p>
        <span class="btn btn-ghost">See GuardianOrbit</span>
      </div>
    </a>
  </section>

  <section class="wrap section">
    <div class="panel">
      <p class="eyebrow">Local help</p>
      <h2>Tech Help in the Palo Alto area</h2>
      <p>PC setup, Wi-Fi, backups, virus cleanup, Windows reinstalls, phones, and smart home. Quotes start as “Ask for quote.”</p>
      <a class="btn btn-gold" href="/tech-help">See services</a>
    </div>
  </section>

  <div class="wrap section" id="newsletter">
    <Newsletter />
  </div>
</BaseLayout>
