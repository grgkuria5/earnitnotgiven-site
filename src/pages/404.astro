---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="That page is not on the Earn It Not Given site." path="/404">
  <div class="wrap section">
    <p class="eyebrow">404</p>
    <h1>That page is not here.</h1>
    <p>The link may be old, or the listing was a draft that is not public.</p>
    <p><a class="btn btn-gold" href="/shop">Back to the shop</a></p>
  </div>
</BaseLayout>
