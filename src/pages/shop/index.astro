---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Catalog from '../../components/Catalog.astro';
import { allProducts, etsyProducts } from '../../lib/site';
const products = await allProducts();
const designs = etsyProducts();
---
<BaseLayout title="Shop" description="Electronics, computers, phones, and EarnItNotGiven designs from Earn It Not Given LLC." path="/shop">
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> <span>Shop</span></nav>
    <h1>Shop</h1>
    <p class="muted">Hand-tested electronics appear here when they are listed. EarnItNotGiven designs check out on Etsy.</p>
    {products.length || designs.length ? <Catalog products={products} designs={designs} /> : <p class="empty">The shop is empty.</p>}
  </div>
</BaseLayout>
