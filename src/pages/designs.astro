---
import BaseLayout from '../layouts/BaseLayout.astro';
import EtsyCards from '../components/EtsyCards.astro';
import { etsyProducts } from '../lib/site';
const designs = etsyProducts();
---
<BaseLayout title="EarnItNotGiven Designs (Etsy)" description="Tees, leggings, bomber jackets, and wall art from EarnItNotGiven. Checkout is on Etsy." path="/designs" tone="fashion">
  <div class="wrap section">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> <span>Designs</span></nav>
    <p class="eyebrow">Print on demand</p>
    <h1>EarnItNotGiven Designs (Etsy)</h1>
    <p class="muted">These are George's listings. The price is the from-price on Etsy. The button opens that listing. There is no checkout for them on this site.</p>
    {designs.length ? (
      <div class="grid cards">
        <EtsyCards designs={designs} />
      </div>
    ) : <p class="empty">No Etsy listings are in the catalog yet.</p>}
  </div>
</BaseLayout>
