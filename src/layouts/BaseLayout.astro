---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ChatWidget from '../components/ChatWidget.astro';
import { createHash } from 'node:crypto';
import { SITE, contentSecurityPolicy, settings } from '../lib/site';
import { jsonForScript } from '../lib/pure';

interface Props {
  title: string;
  description: string;
  path?: string;
  image?: string;
  jsonLd?: unknown;
  tone?: 'tech' | 'fashion';
}
const { title, description, path = Astro.url.pathname, image = '/images/og.png', jsonLd, tone = 'tech' } = Astro.props;
const canonical = new URL(path, SITE).toString();
const fullTitle = title.includes('Earn It Not Given') ? title : `${title} · Earn It Not Given`;
const ld = jsonLd ? jsonForScript(jsonLd) : '';
const scriptHashes = ld ? [createHash('sha256').update(ld, 'utf8').digest('base64')] : [];
const csp = `${await contentSecurityPolicy().then((policy) => policy.replace("script-src 'self'", `script-src 'self'${scriptHashes.map((hash) => ` 'sha256-${hash}'`).join('')}`))}`;
---
<!doctype html>
<html lang="en" data-theme={settings.active_theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, SITE).toString()} />
    <meta property="og:site_name" content="Earn It Not Given" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch.png" />
    {settings.google_site_verification && <meta name="google-site-verification" content={settings.google_site_verification} />}
    {ld && <script type="application/ld+json" set:html={ld} />}
  </head>
  <body class={`tone-${tone}`}>
    <a class="skip" href="#main">Skip to content</a>
    <Header path={path} />
    <main id="main" aria-label="Content">
      <slot />
    </main>
    <Footer />
    <ChatWidget endpoint={settings.chat_ai_endpoint} />
    <script>
      import '../scripts/main.ts';
    </script>
    {settings.analytics_provider === 'cloudflare' && settings.analytics_token && (
      <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={`{"token":"${settings.analytics_token}"}`}></script>
    )}
    {settings.analytics_provider === 'goatcounter' && settings.analytics_token.endsWith('.goatcounter.com') && (
      <script async src="https://gc.zgo.at/count.js" data-goatcounter={`https://${settings.analytics_token}/count`}></script>
    )}
  </body>
</html>
