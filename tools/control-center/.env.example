# Copy to .env on the AIDesktop. Never commit .env.
# Ollama stays on this PC. Do not put a public address here.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=

# Etsy app from https://www.etsy.com/developers/register
# Redirect URI must be exactly the value below.
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=
ETSY_SHOP_ID=
ETSY_REDIRECT_URI=http://127.0.0.1:8765/callback

# Optional. Used only for Printify shop links. Never commits.
PRINTIFY_TOKEN=

# Optional. Used only when you click Approve and commit.
# Fine-grained GitHub token with Contents: Read and write on grgkuria5/earnitnotgiven-site.
GITHUB_TOKEN=
GITHUB_REPO=grgkuria5/earnitnotgiven-site

# Shipping Station. Leave blank until you have an account. Never commit the filled .env.
# Connect UPS or USPS inside Shippo or EasyPost. This app does not store carrier passwords.
SHIPPO_API_KEY=
EASYPOST_API_KEY=
SHIPSTATION_API_KEY=
SHIPSTATION_API_SECRET=
STRIPE_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Snap & List. Keys stay in this file on the AIDesktop. Never commit the filled .env.
# 127.0.0.1 keeps the app on this PC. 0.0.0.0 lets a phone on your LAN or Tailscale open /snap.
# Public internet addresses are still refused.
CONTROL_BIND=127.0.0.1
PRODUCTS_ROOT=C:\Users\Hacking\EarnItNotGiven\Products
# Phone links in notifications. Use the Tailscale or LAN address of this PC.
SNAP_BASE=http://127.0.0.1:8765
# ntfy topic you create yourself. Leave blank to skip ntfy.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
# Home Assistant webhook. Leave blank to skip.
HA_NOTIFY_URL=
HA_TOKEN=
